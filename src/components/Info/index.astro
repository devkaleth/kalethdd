---

<section class={Style.info} id="info">
  <section class={Style.sec_img}>
    <h1>kaleth D. Mendoza</h1>
    <img src="/img/main.png" alt="" />
  </section>
  <section class={Style.sec_items}>
    <a href="https://github.com/devkaleth" target="_blank">
      <Github size="20" />
      <p>Github</p>
    </a>
    <a
      href="https://www.linkedin.com/in/kaleth-david-mendoza-vasquez-532bb4361/"
      target="_blank"
      class={Style.a_linkedin}
    >
      <Linkedin size="20" />
      <p>LinkedIn</p>
    </a>
    <a href="https://twitter.com/kalethdd" target="_blank">
      <Twitter size="20" />
      <p>Twitter</p>
    </a>
  </section>

  <section class={Style.sec_number}>
    <section class={Style.sec_a} id="cv">
      <a href="">Descargar CV</a>
    </section>
    <p>dev.kaleth.mendoza@gmail.com</p>
  </section>
  <section class={Style.sec_kills}></section>
  <div class={Style.skill}>
    <div class={Style.carousel}>
      <div class={Style.track}>
        {
          skills.map((skill) => (
            <a href={skill.url} target="_blank" rel="noopener noreferrer">
              <img
                src={`https://img.shields.io/badge/${skill.logo}&style=for-the-badge`}
                alt={`${skill.name} logo`}
                height="40"
              />
            </a>
          ))
        }
        {/* Duplicado para efecto infinito */}
        {
          skills.map((skill) => (
            <a href={skill.url} target="_blank" rel="noopener noreferrer">
              <img
                src={`https://img.shields.io/badge/${skill.logo}&style=for-the-badge`}
                alt={`${skill.name} logo`}
                height="40"
              />
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <script is:inline>
    const cv = document.querySelector("#cv");
    const url = "/cv/kaleth_david_mendoza_vasquez.pdf";
    cv.addEventListener("click", (e) => {
      e.preventDefault();
      const a = document.createElement("a");
      a.href = url;
      a.download = "kaleth_david_mendoza_vasquez.pdf";
      a.click();
    });
  </script>
</section>
