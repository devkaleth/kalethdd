    <a href="https://vitepoke.vercel.app" target="_blank">
      <article>
        <img src="/img/proyect/vitepoke.png" alt="" />
        <div>
          <h3>VitePoke</h3>
          <p>
            Vitepoke es una frontend el cual consume la api de pokeapi , para
            poder traer todo los pokemones del mundo.
          </p>
          <img
            src="https://img.shields.io/badge/Node.js-339933?logo=nodedotjs&logoColor=white&style=for-the-badge"
            height="40"
            alt="nodejs logo"
          />
          <img
            src="https://img.shields.io/badge/React-61DAFB?logo=react&logoColor=black&style=for-the-badge"
            height="40"
            alt="react logo"
          />
          <img
            src="https://img.shields.io/badge/CSS-1572B6?logo=css&logoColor=white&style=for-the-badge"
            height="40"
            alt="css logo"
          />
